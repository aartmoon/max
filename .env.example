POSTGRES_USER=tvoydom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tvoydom

# Local and production Compose explicitly use the small verified Arbat fixture.
# A full GAR XML import requires an explicit override with GAR_MODE=full.

BACKEND_PORT=8080
FRONTEND_PORT=3000
MOCK_STATUS_ENABLED=true
GIS_HOUSING_BASE_URL=https://dom.gosuslugi.ru
GIS_HOUSING_TIMEOUT=8s
GIS_HOUSE_CACHE_TTL=24h

# Leave SMTP_HOST empty to log auth codes in backend logs instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=false

MAX_BOT_TOKEN=
MAX_APP_URL=
MAX_BOT_USERNAME=
MAX_CA_CERT_FILE=
