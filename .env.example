FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5433
POSTGRES_USER=tvoydom
POSTGRES_PASSWORD=tvoydom_demo
POSTGRES_DB=tvoydom
MOCK_STATUS_ENABLED=true
# Local backend only (Compose sets its own internal URL):
DATABASE_URL=postgres://tvoydom:tvoydom_demo@localhost:5433/tvoydom?sslmode=disable
PORT=8080

# MAX bot: disabled while the token is empty. Keep the real token only in .env.
MAX_BOT_TOKEN=
# Public HTTPS URL of your deployed app or development tunnel (not localhost).
MAX_APP_URL=
# Optional: bot username without @; enables the native mini-app button.
# Set only after linking the mini app to this bot in MAX for Business.
MAX_BOT_USERNAME=
# Optional trusted CA bundle, mounted from ./certs (PEM format).
# MAX_CA_CERT_FILE=/app/certs/max-ca.pem
MAX_CA_CERT_FILE=
